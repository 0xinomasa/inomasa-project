{
  "name": "inomasa",
  "version": "0.0.0",
  "private": true,
  "description": "Inomasa controlled Arc Testnet agentic-business Alpha",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "next dev",
    "alpha:bootstrap": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/alpha-bootstrap.ts",
    "alpha:agent-purchase": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/alpha-agent-purchase.ts",
    "alpha:execute-service": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/alpha-execute-service.ts",
    "alpha:prepare-commerce": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/alpha-prepare-commerce.ts",
    "alpha:submit-settlement": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/alpha-submit-settlement.ts",
    "alpha:reconcile-settlement": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/alpha-reconcile-settlement.ts",
    "alpha:wallets": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/circle-provision-alpha-wallets.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/db-migrate.ts",
    "db:proof": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/db-proof.ts",
    "db:verify": "npm run db:migrate && npm run db:proof",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "npm run clean --silent && next build",
    "start": "next start",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "10.8.0",
    "kysely": "0.29.5",
    "next": "16.3.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
