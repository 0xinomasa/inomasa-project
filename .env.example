# Copy to .env.local for local development. Replace placeholders locally.
# Never commit connection strings or credentials.
INOMASA_ENV=LOCAL_DEVELOPMENT
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Runtime/application connection. A hosted provider may supply a pooled URL.
DATABASE_URL=postgresql://<runtime-user>:<password>@<runtime-host>:5432/<database>?sslmode=<provider-required-mode>

# Administrative/migration connection. Use a direct URL when the provider
# requires it for schema operations.
DATABASE_DIRECT_URL=postgresql://<migration-user>:<password>@<direct-host>:5432/<database>?sslmode=<provider-required-mode>

# Optional positive integer. Omit to use the PostgreSQL driver's default pool size.
DATABASE_POOL_MAX=

# Circle Developer-Controlled Wallets. Private Arc Testnet only for the Alpha.
# Register the entity secret through Circle's secure operator workflow; never commit it.
CIRCLE_API_KEY=<circle-developer-api-key>
CIRCLE_ENTITY_SECRET=<registered-circle-entity-secret>
CIRCLE_WALLET_SET_ID=<circle-developer-wallet-set-id>

# Controlled Product Alpha invitation auth. These are local/operator secrets.
# Invite format: email:code,email:code. Use a random >=32-character secret.
INOMASA_AUTH_SECRET=<random-at-least-32-character-session-secret>
INOMASA_ALPHA_INVITES=<invited-email>:<invite-code>

# NEXT_PUBLIC_* values are shipped to the browser and must never contain secrets.

# Optional AI drafting adapter. Select a Gemini model supported by your existing account.
# The server submits one bounded generation per explicit request, with no auto-retry.
GEMINI_API_KEY=
INOMASA_AI_MODEL=

# Optional controlled HTTP JSON sources; each source belongs to one invited principal.
# Example shape only (fill approved URLs and principal locally; no secrets in URLs):
# [{"sourceId":"catalog","label":"My Business","controllerPrincipalId":"usr_...","manifestUrl":"https://example.com/inomasa.json","resourceUrl":"https://example.com/service.json"}]
INOMASA_CONNECT_SOURCES=
# Enable only for an explicitly configured HTTP source on 127.0.0.1/localhost.
INOMASA_CONNECT_ALLOW_LOOPBACK=false
